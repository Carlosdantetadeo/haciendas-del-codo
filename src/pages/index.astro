</body>
</html>

<style>
  /* ========== RESET & BASE ========== */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --verde-oscuro: #1a3a2a;
    --verde-medio: #2d5a40;
    --verde-claro: #4a8c62;
    --dorado: #c9a84c;
    --dorado-claro: #e8c96a;
    --crema: #f5f0e8;
    --blanco: #ffffff;
    --gris-claro: #f8f8f6;
    --gris: #6b7280;
    --oscuro: #1a1a1a;
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --radius: 12px;
    --shadow: 0 4px 24px rgba(0,0,0,0.08);
    --shadow-lg: 0 8px 40px rgba(0,0,0,0.12);
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    color: var(--oscuro);
    background: var(--blanco);
    line-height: 1.6;
  }

  h1, h2, h3 { font-family: var(--font-display); line-height: 1.2; }
  h1 { font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 700; }
  h2 { font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 600; }
  h3 { font-size: 1.3rem; font-weight: 600; }
  h4 { font-size: 1.05rem; font-weight: 600; font-family: var(--font-body); }
  h5 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--verde-claro); margin-bottom: 0.75rem; }
  p { color: var(--gris); }
  a { text-decoration: none; }
  em { font-style: italic; color: var(--dorado); }

  .container { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }

  .section-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--verde-claro);
    margin-bottom: 0.75rem;
  }

  /* ========== BUTTONS ========== */
  .btn-primary {
    display: inline-block;
    background: var(--dorado);
    color: var(--oscuro);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 50px;
    transition: all 0.2s;
  }
  .btn-primary:hover { background: var(--dorado-claro); transform: translateY(-1px); box-shadow: 0 6px 24px rgba(201,168,76,0.4); }
  .btn-primary.large { font-size: 1.1rem; padding: 1.1rem 2.5rem; }

  .btn-secondary {
    display: inline-block;
    color: var(--blanco);
    font-weight: 500;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 50px;
    border: 2px solid rgba(255,255,255,0.5);
    transition: all 0.2s;
  }
  .btn-secondary:hover { border-color: var(--blanco); background: rgba(255,255,255,0.1); }

  .btn-outline {
    display: inline-block;
    color: var(--verde-oscuro);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.875rem 2rem;
    border-radius: 50px;
    border: 2px solid var(--verde-oscuro);
    transition: all 0.2s;
  }
  .btn-outline:hover { background: var(--verde-oscuro); color: var(--blanco); }

  .btn-nav {
    display: inline-block;
    background: var(--dorado);
    color: var(--oscuro);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    transition: all 0.2s;
  }
